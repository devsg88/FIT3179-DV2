{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline distributions of total sugars, dietary fibre and sodium per 100 grams across ten broad AUSNUT 2023 food groups.",
  "background": "#ffffff",
  "padding": 0,
  "title": {
    "text": "Nutrient profiles vary widely across food categories",
    "subtitle": [
      "AUSNUT 2023 foods: nutrient content per 100 g",
      "Each ridge is scaled to its own peak; horizontal spread shows variation.",
      "The sodium axis compresses large values; read its labelled ticks."
    ],
    "anchor": "start",
    "fontSize": 23,
    "subtitleFontSize": 15,
    "subtitlePadding": 8,
    "offset": 20,
    "color": "#243746",
    "subtitleColor": "#20333b",
    "frame": "bounds"
  },
  "data": {
    "url": "Formatted Data/ausnut_ridgeline_nutrients.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Food_ID": "string",
        "Value": "number"
      }
    }
  },
  "hconcat": [
    {
      "title": {
        "text": "Total sugars",
        "subtitle": "grams per 100 g",
        "anchor": "start",
        "fontSize": 16,
        "subtitleFontSize": 15,
        "color": "#B44578",
        "subtitleColor": "#20333b",
        "offset": 10,
        "frame": "group"
      },
      "transform": [
        {
          "filter": "datum.Nutrient === 'Total sugars (g/100 g)'"
        },
        {
          "density": "Value",
          "groupby": [
            "Food_Group"
          ],
          "extent": [
            0,
            100
          ],
          "steps": 300,
          "as": [
            "NutrientValue",
            "Density"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "Density",
              "as": "PeakDensity"
            }
          ],
          "groupby": [
            "Food_Group"
          ]
        },
        {
          "calculate": "datum.PeakDensity > 0 ? datum.Density / datum.PeakDensity : 0",
          "as": "RelativeDensity"
        }
      ],
      "facet": {
        "row": {
          "field": "Food_Group",
          "type": "nominal",
          "sort": [
            "Cereals and cereal products",
            "Cereal based products and dishes",
            "Fruit products and dishes",
            "Vegetable products and dishes",
            "Meat, poultry and game products and dishes",
            "Milk products and dishes",
            "Savoury sauces and condiments",
            "Snack foods",
            "Sugar products and dishes",
            "Confectionery and cereal, nut, fruit and seed bars"
          ],
          "header": {
            "title": null,
            "labelAngle": 0,
            "labelAlign": "left",
            "labelFontSize": 15,
            "labelFontWeight": "bold",
            "labelColor": "#20333b",
            "labelLimit": 240,
            "labelExpr": "datum.value === 'Confectionery and cereal, nut, fruit and seed bars' ? 'Confectionery and bars' : datum.value === 'Meat, poultry and game products and dishes' ? 'Meat, poultry and game' : datum.value === 'Cereal based products and dishes' ? 'Cereal-based dishes' : datum.value === 'Savoury sauces and condiments' ? 'Sauces and condiments' : datum.label",
            "labelLineHeight": 17,
            "labelPadding": 10
          }
        }
      },
      "spec": {
        "width": 200,
        "height": 40,
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fill": "#B44578",
          "fillOpacity": 0.25,
          "stroke": "#B44578",
          "strokeWidth": 1.8,
          "clip": false,
          "cursor": "crosshair"
        },
        "encoding": {
          "x": {
            "field": "NutrientValue",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                100
              ],
              "nice": false,
              "zero": true
            },
            "axis": {
              "title": "Total sugars (g/100 g)",
              "titleFontSize": 15,
              "titlePadding": 12,
              "labelFontSize": 15,
              "values": [
                0,
                25,
                50,
                75,
                100
              ],
              "grid": false,
              "domainColor": "#AAB7C4",
              "tickColor": "#AAB7C4"
            }
          },
          "y": {
            "field": "RelativeDensity",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                1
              ],
              "range": [
                34,
                -10
              ],
              "clamp": true
            },
            "axis": null
          },
          "tooltip": [
            {
              "field": "Food_Group",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "NutrientValue",
              "type": "quantitative",
              "title": "Sugar (g/100 g)",
              "format": ".1f"
            },
            {
              "field": "RelativeDensity",
              "type": "quantitative",
              "title": "Relative density",
              "format": ".2f"
            }
          ]
        }
      }
    },
    {
      "title": {
        "text": "Dietary fibre",
        "subtitle": "grams per 100 g",
        "anchor": "start",
        "fontSize": 16,
        "subtitleFontSize": 15,
        "color": "#387C44",
        "subtitleColor": "#20333b",
        "offset": 10,
        "frame": "group"
      },
      "transform": [
        {
          "filter": "datum.Nutrient === 'Dietary fibre (g/100 g)'"
        },
        {
          "density": "Value",
          "groupby": [
            "Food_Group"
          ],
          "extent": [
            0,
            45
          ],
          "steps": 300,
          "as": [
            "NutrientValue",
            "Density"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "Density",
              "as": "PeakDensity"
            }
          ],
          "groupby": [
            "Food_Group"
          ]
        },
        {
          "calculate": "datum.PeakDensity > 0 ? datum.Density / datum.PeakDensity : 0",
          "as": "RelativeDensity"
        }
      ],
      "facet": {
        "row": {
          "field": "Food_Group",
          "type": "nominal",
          "sort": [
            "Cereals and cereal products",
            "Cereal based products and dishes",
            "Fruit products and dishes",
            "Vegetable products and dishes",
            "Meat, poultry and game products and dishes",
            "Milk products and dishes",
            "Savoury sauces and condiments",
            "Snack foods",
            "Sugar products and dishes",
            "Confectionery and cereal, nut, fruit and seed bars"
          ],
          "header": {
            "title": null,
            "labels": false,
            "labelFontSize": 15,
            "labelLimit": 240,
            "labelLineHeight": 17
          }
        }
      },
      "spec": {
        "width": 200,
        "height": 40,
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fill": "#387C44",
          "fillOpacity": 0.25,
          "stroke": "#387C44",
          "strokeWidth": 1.8,
          "clip": false,
          "cursor": "crosshair"
        },
        "encoding": {
          "x": {
            "field": "NutrientValue",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                45
              ],
              "nice": false,
              "zero": true
            },
            "axis": {
              "title": "Dietary fibre (g/100 g)",
              "titleFontSize": 15,
              "titlePadding": 12,
              "labelFontSize": 15,
              "values": [
                0,
                10,
                20,
                30,
                40
              ],
              "grid": false,
              "domainColor": "#AAB7C4",
              "tickColor": "#AAB7C4"
            }
          },
          "y": {
            "field": "RelativeDensity",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                1
              ],
              "range": [
                34,
                -10
              ],
              "clamp": true
            },
            "axis": null
          },
          "tooltip": [
            {
              "field": "Food_Group",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "NutrientValue",
              "type": "quantitative",
              "title": "Fibre (g/100 g)",
              "format": ".1f"
            },
            {
              "field": "RelativeDensity",
              "type": "quantitative",
              "title": "Relative density",
              "format": ".2f"
            }
          ]
        }
      }
    },
    {
      "title": {
        "text": "Sodium",
        "subtitle": "milligrams per 100 g · compressed axis",
        "anchor": "start",
        "fontSize": 16,
        "subtitleFontSize": 15,
        "color": "#B54F22",
        "subtitleColor": "#20333b",
        "offset": 10,
        "frame": "group"
      },
      "transform": [
        {
          "filter": "datum.Nutrient === 'Sodium (mg/100 g)'"
        },
        {
          "density": "Value",
          "groupby": [
            "Food_Group"
          ],
          "extent": [
            0,
            8500
          ],
          "steps": 400,
          "as": [
            "NutrientValue",
            "Density"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "Density",
              "as": "PeakDensity"
            }
          ],
          "groupby": [
            "Food_Group"
          ]
        },
        {
          "calculate": "datum.PeakDensity > 0 ? datum.Density / datum.PeakDensity : 0",
          "as": "RelativeDensity"
        }
      ],
      "facet": {
        "row": {
          "field": "Food_Group",
          "type": "nominal",
          "sort": [
            "Cereals and cereal products",
            "Cereal based products and dishes",
            "Fruit products and dishes",
            "Vegetable products and dishes",
            "Meat, poultry and game products and dishes",
            "Milk products and dishes",
            "Savoury sauces and condiments",
            "Snack foods",
            "Sugar products and dishes",
            "Confectionery and cereal, nut, fruit and seed bars"
          ],
          "header": {
            "title": null,
            "labels": false,
            "labelFontSize": 15,
            "labelLimit": 240,
            "labelLineHeight": 17
          }
        }
      },
      "spec": {
        "width": 230,
        "height": 40,
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fill": "#B54F22",
          "fillOpacity": 0.25,
          "stroke": "#B54F22",
          "strokeWidth": 1.8,
          "clip": false,
          "cursor": "crosshair"
        },
        "encoding": {
          "x": {
            "field": "NutrientValue",
            "type": "quantitative",
            "scale": {
              "type": "symlog",
              "constant": 100,
              "domain": [
                0,
                8500
              ],
              "nice": false,
              "zero": true
            },
            "axis": {
              "title": "Sodium (mg/100 g)",
              "titleFontSize": 15,
              "titlePadding": 12,
              "labelFontSize": 15,
              "values": [
                0,
                100,
                1000,
                8000
              ],
              "labelExpr": "datum.value >= 1000 ? format(datum.value / 1000, '.0f') + 'k' : datum.label",
              "grid": false,
              "domainColor": "#AAB7C4",
              "tickColor": "#AAB7C4"
            }
          },
          "y": {
            "field": "RelativeDensity",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                1
              ],
              "range": [
                34,
                -10
              ],
              "clamp": true
            },
            "axis": null
          },
          "tooltip": [
            {
              "field": "Food_Group",
              "type": "nominal",
              "title": "Food group"
            },
            {
              "field": "NutrientValue",
              "type": "quantitative",
              "title": "Sodium (mg/100 g)",
              "format": ".0f"
            },
            {
              "field": "RelativeDensity",
              "type": "quantitative",
              "title": "Relative density",
              "format": ".2f"
            }
          ]
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "style": {
      "guide-label": {
        "lineBreak": "|"
      }
    },
    "concat": {
      "spacing": 28
    },
    "facet": {
      "spacing": 0
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "gridColor": "#e5e9eb",
      "domain": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "background": "#ffffff",
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "title": {
      "anchor": "start",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57",
      "frame": "bounds"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  }
}
