{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "config": {
    "font": "Inter",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "frame": "bounds",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57"
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 8,
      "titlePadding": 12,
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "gridColor": "#e5e9eb",
      "domain": false
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  },
  "description": "Archived paired view of the two separately displayed maps, without reference rings.",
  "title": {
    "text": "Sodium and potassium intake estimates",
    "subtitle": [
      "Adults 19 and over, 2011–12.",
      "Separate restricted size scales; compare circles within each map only."
    ],
    "anchor": "start"
  },
  "hconcat": [
    {
      "width": 600,
      "height": 440,
      "projection": {
        "type": "mercator",
        "scale": 570,
        "translate": [
          -1060,
          -70
        ]
      },
      "title": {
        "text": "Sodium intake by state and territory",
        "subtitle": [
          "Average daily intake, adults 19 and over, 2011–12 (mg).",
          "Restricted size scale; compare circles within this map only."
        ],
        "anchor": "start"
      },
      "layer": [
        {
          "data": {
            "url": "topojson files/STE_2021_AUST_GDA2020.json",
            "format": {
              "type": "topojson",
              "feature": "STE_2021_AUST_GDA2020"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#f0f0f0",
            "stroke": "#b0b0b0",
            "strokeWidth": 0.7
          }
        },
        {
          "data": {
            "url": "Formatted Data/Australian_Sodium_Potassium_19plus.csv",
            "format": {
              "type": "csv",
              "parse": {
                "labelDx": "number",
                "labelDy": "number",
                "longitude": "number",
                "latitude": "number"
              }
            }
          },
          "mark": {
            "type": "point",
            "shape": "circle",
            "filled": true,
            "color": "#B54F22",
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "size": {
              "field": "Sodium Intake (mg) - 19 and over",
              "type": "quantitative",
              "scale": {
                "type": "linear",
                "domain": [
                  2380.6,
                  2496.3
                ],
                "range": [
                  120,
                  900
                ],
                "zero": false,
                "nice": false
              },
              "legend": {
                "title": "Sodium intake (mg)",
                "orient": "bottom",
                "values": [
                  2380.6,
                  2440,
                  2496.3
                ],
                "format": ",.0f",
                "titleLimit": 450,
                "symbolFill": "#B54F22",
                "symbolStroke": "transparent",
                "symbolOpacity": 1
              }
            },
            "tooltip": [
              {
                "field": "State/Territory",
                "type": "nominal",
                "title": "State / territory"
              },
              {
                "field": "Sodium Intake (mg) - 19 and over",
                "type": "quantitative",
                "title": "Sodium intake (mg/day)",
                "format": ",.0f"
              },
              {
                "field": "Sodium MOE (mg)",
                "type": "quantitative",
                "title": "Approx. 95% margin of error (± mg)",
                "format": ",.0f"
              },
              {
                "field": "Sodium RSE (%)",
                "type": "quantitative",
                "title": "Relative standard error (%)",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "Formatted Data/Australian_Sodium_Potassium_19plus.csv",
            "format": {
              "type": "csv",
              "parse": {
                "labelDx": "number",
                "labelDy": "number",
                "longitude": "number",
                "latitude": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "datum.abbr + ' ' + format(datum['Sodium Intake (mg) - 19 and over'], ',.0f')",
              "as": "StateValue"
            }
