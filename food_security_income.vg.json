{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "padding": 0,
  "config": {
    "font": "Inter",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "frame": "bounds",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57"
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 8,
      "titlePadding": 12,
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "gridColor": "#e5e9eb",
      "domain": false
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  },
  "description": "Butterfly chart of published food-secure and food-insecure household percentages by income. Both sides share a 0–100% range.",
  "title": {
    "text": "Food security improves as household income rises",
    "subtitle": [
      "Households by food security status (%), 2023",
      "Five income groups, adjusted for household size and composition."
    ],
    "anchor": "start"
  },
  "data": {
    "url": "Formatted Data/food_security_by_income_quintile.csv",
    "format": {
      "type": "csv",
      "parse": {
        "food_secure_pct": "number",
        "food_insecure_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.income_quintile === 'Lowest quintile' ? 'Lowest income' : datum.income_quintile === '2nd quintile' ? 'Lower-middle income' : datum.income_quintile === '3rd quintile' ? 'Middle income' : datum.income_quintile === '4th quintile' ? 'Upper-middle income' : 'Highest income'",
      "as": "IncomeLabel"
    },
    {
      "calculate": "format(datum.food_secure_pct, '.1f') + '%'",
      "as": "Food secureLabel"
    },
    {
      "calculate": "format(datum.food_insecure_pct, '.1f') + '%'",
      "as": "Food insecureLabel"
    }
  ],
  "hconcat": [
    {
      "title": {
        "text": "Food secure",
        "anchor": "middle",
        "color": "#586D88"
      },
      "width": 270,
      "height": 290,
      "encoding": {
        "y": {
          "field": "income_quintile",
          "type": "ordinal",
          "sort": [
            "Lowest quintile",
            "2nd quintile",
            "3rd quintile",
            "4th quintile",
            "Highest quintile"
          ],
          "axis": null,
          "title": null
        },
        "x": {
          "field": "food_secure_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": true,
            "nice": false,
            "zero": true
          },
          "axis": {
            "orient": "top",
            "title": "Households (%)",
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "tickSize": 0
          }
        },
        "tooltip": [
          {
            "field": "IncomeLabel",
            "type": "nominal",
            "title": "Income group"
          },
          {
            "field": "food_secure_pct",
            "type": "quantitative",
            "title": "Food secure (%)",
            "format": ".1f"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#586D88",
            "size": 30
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -7,
            "fontSize": 15
          },
          "encoding": {
            "text": {
              "field": "Food secureLabel"
            }
          }
        }
      ]
    },
    {
      "width": 174,
      "height": 290,
      "title": {
        "text": "Income group",
        "anchor": "middle"
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 15
      },
      "encoding": {
        "y": {
          "field": "income_quintile",
          "type": "ordinal",
          "sort": [
            "Lowest quintile",
            "2nd quintile",
            "3rd quintile",
            "4th quintile",
            "Highest quintile"
          ],
          "axis": null,
          "title": null
        },
        "text": {
          "field": "IncomeLabel"
        }
      }
    },
    {
      "title": {
        "text": "Food insecure",
        "anchor": "middle",
        "color": "#843C58"
      },
      "width": 270,
      "height": 290,
      "encoding": {
        "y": {
          "field": "income_quintile",
          "type": "ordinal",
          "sort": [
            "Lowest quintile",
            "2nd quintile",
            "3rd quintile",
            "4th quintile",
            "Highest quintile"
          ],
          "axis": null,
          "title": null
        },
        "x": {
          "field": "food_insecure_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "reverse": false,
            "nice": false,
            "zero": true
          },
          "axis": {
            "orient": "top",
            "title": "Households (%)",
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "tickSize": 0
          }
        },
        "tooltip": [
          {
            "field": "IncomeLabel",
            "type": "nominal",
            "title": "Income group"
          },
          {
            "field": "food_insecure_pct",
            "type": "quantitative",
            "title": "Food insecure (%)",
            "format": ".1f"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#843C58",
            "size": 30
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 7,
            "fontSize": 15
          },
          "encoding": {
            "text": {
              "field": "Food insecureLabel"
            }
          }
        }
      ]
    }
  ],
  "spacing": 12,
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "shared"
    }
  }
}
