{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Energy contribution from nutrients by age (2023)",
    "subtitle": "Lines show how each nutrient's share of energy changes across age groups.",
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "Formatted Data/macronutrient_parallel_coordinates.csv"
  },
  "width": 670,
  "height": 370,
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 2.5,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "Age_Group",
      "type": "ordinal",
      "sort": [
        "2–4",
        "5–11",
        "12–17",
        "18–29",
        "30–49",
        "50–64",
        "65–74",
        "75+"
      ],
      "axis": {
        "title": "Age group",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Energy_Percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          50
        ]
      },
      "axis": {
        "title": "Energy contribution (%)",
        "format": ".0f"
      }
    },
    "color": {
      "field": "Nutrient",
      "type": "nominal",
      "sort": [
        "Protein",
        "Total fat",
        "Carbohydrate",
        "Total sugars",
        "Dietary fibre"
      ],
      "legend": {
        "title": "Nutrient type"
      }
    },
    "tooltip": [
      {
        "field": "Age_Group",
        "title": "Age group"
      },
      {
        "field": "Nutrient"
      },
      {
        "field": "Energy_Percent",
        "title": "Energy contribution (%)",
        "format": ".1f"
      }
    ],
    "detail": {
      "field": "Nutrient",
      "type": "nominal"
    }
  },
  "padding": 0,
  "config": {
    "font": "Inter",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "frame": "bounds",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57"
    },
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 8,
      "titlePadding": 12,
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "gridColor": "#e5e9eb",
      "domain": false
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  }
}
