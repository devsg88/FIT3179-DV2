{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Energy contribution from nutrients by age (2023)",
    "subtitle": "Lines show how each nutrient's share of energy changes across age groups."
  },
  "data": {
    "url": "Formatted Data/macronutrient_parallel_coordinates.csv"
  },
  "width": 670,
  "height": 370,
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 2.5,
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "Age_Group",
      "type": "ordinal",
      "sort": [
        "2–4",
        "5–11",
        "12–17",
        "18–29",
        "30–49",
        "50–64",
        "65–74",
        "75+"
      ],
      "axis": {
        "title": "Age group",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Energy_Percent",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          50
        ]
      },
      "axis": {
        "title": "Energy contribution (%)",
        "format": ".0f"
      }
    },
    "color": {
      "field": "Nutrient",
      "type": "nominal",
      "sort": [
        "Protein",
        "Total fat",
        "Carbohydrate",
        "Total sugars",
        "Dietary fibre"
      ],
      "legend": {
        "title": "Nutrient type"
      }
    },
    "tooltip": [
      {
        "field": "Age_Group",
        "title": "Age group"
      },
      {
        "field": "Nutrient"
      },
      {
        "field": "Energy_Percent",
        "title": "Energy contribution (%)",
        "format": ".1f"
      }
    ],
    "detail": {
      "field": "Nutrient",
      "type": "nominal"
    }
  }
}
