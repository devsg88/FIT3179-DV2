{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Actual daily food serves compared with adult recommendations. Grey background bars show recommendations; slate bars show actual intake.",
  "spacing": 30,
  "vconcat": [
    {
      "hconcat": [
        {
          "title": "Male (18–29)",
          "width": 300,
          "height": {
            "step": 52
          },
          "layer": [
            {
              "data": {
                "url": "Formatted Data/male_recommended_19_50.csv"
              },
              "mark": {
                "type": "bar",
                "size": 32
              },
              "encoding": {
                "x": {
                  "field": "recommended_daily_serves",
                  "type": "quantitative",
                  "title": "Serves per person per day",
                  "scale": {
                    "domain": [
                      0,
                      7
                    ],
                    "zero": true,
                    "nice": false
                  }
                },
                "y": {
                  "field": "food_group",
                  "type": "nominal",
                  "title": null,
                  "axis": {
                    "labelLimit": 190,
                    "labelFontSize": 15,
                    "labelExpr": "datum.label === 'Vegetables and legumes/beans' ? 'Vegetables / legumes' : datum.label === 'Milk, yoghurt, cheese and alternatives' ? 'Dairy / alternatives' : datum.label === 'Lean meats and alternatives' ? 'Meat / alternatives' : datum.label"
                  }
                },
                "tooltip": [
                  {
                    "field": "food_group",
                    "type": "nominal",
                    "title": "Food group"
                  },
                  {
                    "field": "recommended_daily_serves",
                    "type": "quantitative",
                    "format": ".1f",
                    "title": "Daily serves"
                  }
                ],
                "color": {
                  "field": "Measure",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Actual intake",
                      "Recommended serves"
                    ],
                    "range": [
                      "#344B5E",
                      "#dedede"
                    ]
                  },
                  "legend": {
                    "title": null,
                    "orient": "top",
                    "direction": "horizontal",
                    "symbolType": "square"
                  }
                }
              },
              "transform": [
                {
                  "calculate": "'Recommended serves'",
                  "as": "Measure"
                }
              ]
            },
            {
              "data": {
                "url": "Formatted Data/male_actual_18_29.csv"
