{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Faceted deviation charts showing how each nutrient's contribution to energy changes from the ages 2–4 baseline.",
  "background": "#ffffff",
  "padding": 0,
  "title": {
    "text": "How nutrient contributions shift with age","subtitle": ["Change in energy share compared with ages 2–4.", "Units: percentage points, the gap between two percentages.", "The same scale is used in every panel."],
    "anchor": "start",
    "fontSize": 23,
    "subtitleFontSize": 15,
    "subtitlePadding": 8,
    "offset": 18,
    "color": "#243746",
    "subtitleColor": "#20333b",
    "frame": "bounds"
  },
  "data": {
    "url": "Formatted Data/macronutrient_parallel_coordinates.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Energy_Percent": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.Age_Group === '2–4' ? datum.Energy_Percent : null",
      "as": "BaselineCandidate"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "BaselineCandidate",
          "as": "BaselinePercent"
        }
      ],
      "groupby": [
        "Nutrient"
      ]
    },
    {
      "calculate": "datum.Energy_Percent - datum.BaselinePercent",
      "as": "PercentagePointChange"
    },
    {
      "calculate": "datum.Nutrient === 'Protein' && datum.Age_Group === '30–49' ? 'Peak: +3.8 percentage points' : datum.Nutrient === 'Total fat' && datum.Age_Group === '12–17' ? 'Small peak: +1.5 percentage points' : datum.Nutrient === 'Carbohydrate' && datum.Age_Group === '65–74' ? 'Lowest point: −8.1 percentage points' : datum.Nutrient === 'Total sugars' && datum.Age_Group === '30–49' ? 'Largest drop: −5.3 percentage points' : datum.Nutrient === 'Dietary fibre' && datum.Age_Group === '12–17' ? 'Nearly flat: −0.3 to +0.1 percentage points' : null",
      "as": "AnnotationText"
    },
    {
      "calculate": "datum.Nutrient === 'Protein' ? 5.1 : datum.Nutrient === 'Total fat' ? 3.0 : datum.Nutrient === 'Carbohydrate' ? -6.1 : datum.Nutrient === 'Total sugars' ? -2.7 : datum.Nutrient === 'Dietary fibre' ? 1.5 : 0",
      "as": "AnnotationY"
    }
  ],
  "facet": {
    "field": "Nutrient",
    "type": "nominal",
    "sort": [
      "Protein",
      "Total fat",
      "Carbohydrate",
      "Total sugars",
      "Dietary fibre"
    ],
    "header": {
      "title": null,
      "labelAnchor": "start",
      "labelColor": "#20333b",
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelPadding": 8
    }
  },
  "columns": 2,
  "spec": {
    "width": 380,
    "height": 260,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#7C8992",
          "strokeWidth": 1.2
        },
        "encoding": {
          "y": {
            "datum": 0
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "strokeWidth": 3.5
        },
        "encoding": {
          "x": {
            "field": "Age_Group",
            "type": "ordinal",
            "sort": [
              "2–4",
              "5–11",
              "12–17",
              "18–29",
              "30–49",
              "50–64",
              "65–74",
              "75+"
            ],
            "axis": {
              "title": "Age group",
              "labelAngle": -35,
              "labelFontSize": 15,
              "labelLimit": 55,
              "titleFontSize": 15,
              "titlePadding": 8
            }
          },
          "y": {
            "field": "PercentagePointChange",
            "type": "quantitative",
            "scale": {
              "domain": [
                -9,
                6
              ]
            },
            "axis": {
              "title": "Change (percentage points)",
              "values": [
                -8,
                -4,
                0,
                4
              ],
              "labelFontSize": 15,
              "titleFontSize": 15,
              "grid": true
            }
          },
          "color": {
            "field": "Nutrient",
            "type": "nominal",
            "scale": {
              "domain": [
                "Protein",
                "Total fat",
                "Carbohydrate",
                "Dietary fibre",
                "Total sugars"
              ],
              "range": [
                "#2166AC",
                "#A66100",
                "#5B4B9A",
                "#387C44",
                "#B44578"
              ]
            },
            "legend": null
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 105,
          "stroke": "#ffffff",
          "strokeWidth": 1,
          "opacity": 1
        },
        "encoding": {
          "x": {
            "field": "Age_Group",
            "type": "ordinal",
            "sort": [
              "2–4",
              "5–11",
              "12–17",
              "18–29",
              "30–49",
              "50–64",
              "65–74",
              "75+"
            ]
          },
          "y": {
            "field": "PercentagePointChange",
            "type": "quantitative"
          },
          "color": {
            "field": "Nutrient",
            "type": "nominal",
            "scale": {
              "domain": [
                "Protein",
                "Total fat",
                "Carbohydrate",
                "Dietary fibre",
                "Total sugars"
              ],
              "range": [
                "#2166AC",
                "#A66100",
                "#5B4B9A",
                "#387C44",
                "#B44578"
              ]
            },
            "legend": null
          },
          "tooltip": [
            {
              "field": "Nutrient",
              "type": "nominal",
              "title": "Nutrient"
            },
            {
              "field": "Age_Group",
              "type": "ordinal",
              "title": "Age group"
            },
            {
              "field": "Energy_Percent",
              "type": "quantitative",
              "title": "Energy contribution (%)",
              "format": ".1f"
            },
            {
              "field": "BaselinePercent",
              "type": "quantitative",
              "title": "Ages 2–4 baseline (%)",
              "format": ".1f"
            },
            {
              "field": "PercentagePointChange",
              "type": "quantitative",
              "title": "Change (percentage points)",
              "format": "+.1f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.AnnotationText !== null"
          }
        ],
        "mark": {
          "type": "rule",
          "color": "#6B7280",
          "strokeWidth": 1.2,
          "strokeDash": [
            3,
            3
          ]
        },
        "encoding": {
          "x": {
            "field": "Age_Group",
            "type": "ordinal",
            "sort": [
              "2–4",
              "5–11",
              "12–17",
              "18–29",
              "30–49",
              "50–64",
              "65–74",
              "75+"
            ]
          },
          "y": {
            "field": "PercentagePointChange",
            "type": "quantitative"
          },
          "y2": {
            "field": "AnnotationY"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.AnnotationText !== null"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 15,
          "fontWeight": "bold",
          "align": "right",
          "baseline": "middle",
          "fill": "#ffffff",
          "stroke": "#ffffff",
          "strokeWidth": 4,
          "dx": -4
        },
        "encoding": {
          "x": {
            "field": "Age_Group",
            "type": "ordinal",
            "sort": [
              "2–4",
              "5–11",
              "12–17",
              "18–29",
              "30–49",
              "50–64",
              "65–74",
              "75+"
            ]
          },
          "y": {
            "field": "AnnotationY",
            "type": "quantitative"
          },
          "text": {
            "field": "AnnotationText",
            "type": "nominal"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.AnnotationText !== null"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 15,
          "fontWeight": "bold",
          "align": "right",
          "baseline": "middle",
          "color": "#34495E",
          "dx": -4
        },
        "encoding": {
          "x": {
            "field": "Age_Group",
            "type": "ordinal",
            "sort": [
              "2–4",
              "5–11",
              "12–17",
              "18–29",
              "30–49",
              "50–64",
              "65–74",
              "75+"
            ]
          },
          "y": {
            "field": "AnnotationY",
            "type": "quantitative"
          },
          "text": {
            "field": "AnnotationText",
            "type": "nominal"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickColor": "#CAD2D8",
      "gridColor": "#e5e9eb",
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "facet": {
      "spacing": {
        "row": 55,
        "column": 28
      }
    },
    "background": "#ffffff",
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "title": {
      "anchor": "start",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57",
      "frame": "bounds"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  }
}
