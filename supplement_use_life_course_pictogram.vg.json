{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal isotype chart showing the proportion of Australians in each age group who consumed any dietary supplement on the day before interview. Each row contains 20 person icons and each icon represents five people. Source: ABS NNPAS 2023, Table 9.1.",
  "background": "#ffffff",
  "padding": 0,
  "width": 760,
  "height": {
    "step": 58
  },
  "title": {
    "text": "Supplement use differs sharply across the life course",
    "subtitle": [
      "Supplement use on the day before interview, Australia, 2023",
      "One person = 5 in every 100; olive shows use and grey shows no use.",
      "A faded person indicates a partial group; row labels give exact estimates."
    ],
    "anchor": "start",
    "fontSize": 23,
    "subtitleFontSize": 15,
    "subtitlePadding": 8,
    "offset": 20,
    "color": "#243746",
    "subtitleColor": "#20333b",
    "frame": "bounds"
  },
  "data": {
    "url": "Formatted Data/supplement_use_life_course_pictogram.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Age_Order": "number",
        "Exact_Percent": "number",
        "Icon_Index": "number",
        "Fill_Amount": "number",
        "People_Per_Icon": "number"
      }
    }
  },
  "encoding": {
    "y": {
      "field": "Age_Group",
      "type": "ordinal",
      "sort": [
        "2–4 years",
        "5–11 years",
        "12–17 years",
        "18–29 years",
        "30–49 years",
        "50–64 years",
        "65–74 years",
        "75+ years"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 15,
        "labelFontWeight": "bold",
        "labelColor": "#20333b",
        "labelPadding": 14,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M0,-6 A2.2,2.2 0 1,1 0,-1.6 A2.2,2.2 0 1,1 0,-6 M-3.7,1 C-3.7,-0.5 -2.5,-1.2 0,-1.2 C2.5,-1.2 3.7,-0.5 3.7,1 L3.7,4.3 L2.2,4.3 L2.2,9 L0.7,9 L0.7,4.6 L-0.7,4.6 L-0.7,9 L-2.2,9 L-2.2,4.3 L-3.7,4.3 Z",
        "size": 36,
        "color": "#D9E0E5",
        "stroke": "#ffffff",
        "strokeWidth": 0.6
      },
      "encoding": {
        "x": {
          "field": "Icon_Index",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              22.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Fill_Amount > 0"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M0,-6 A2.2,2.2 0 1,1 0,-1.6 A2.2,2.2 0 1,1 0,-6 M-3.7,1 C-3.7,-0.5 -2.5,-1.2 0,-1.2 C2.5,-1.2 3.7,-0.5 3.7,1 L3.7,4.3 L2.2,4.3 L2.2,9 L0.7,9 L0.7,4.6 L-0.7,4.6 L-0.7,9 L-2.2,9 L-2.2,4.3 L-3.7,4.3 Z",
        "size": 36,
        "color": "#626C43",
        "stroke": "#ffffff",
        "strokeWidth": 0.6,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Icon_Index",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              22.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "opacity": {
          "field": "Fill_Amount",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "range": [
              0,
              1
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Age_Group",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Exact_Percent",
            "type": "quantitative",
            "title": "Took any supplement (%)",
            "format": ".1f"
          },
          {
            "field": "Icon_Status",
            "type": "nominal",
            "title": "Icon fill"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Icon_Index === 1"
        },
        {
          "calculate": "21.1",
          "as": "LabelPosition"
        },
        {
          "calculate": "format(datum.Exact_Percent, '.1f') + '%'",
          "as": "PercentageLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#626C43"
      },
      "encoding": {
        "x": {
          "field": "LabelPosition",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              22.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "text": {
          "field": "PercentageLabel",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "axis": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b",
      "gridColor": "#e5e9eb",
      "domain": false,
      "labelPadding": 8,
      "titlePadding": 12
    },
    "legend": {
      "labelFontSize": 15,
      "titleFontSize": 15,
      "labelColor": "#20333b",
      "titleColor": "#20333b"
    },
    "title": {
      "anchor": "start",
      "fontSize": 20,
      "subtitleFontSize": 15,
      "subtitleLineHeight": 21,
      "color": "#20333b",
      "subtitleColor": "#414f57",
      "frame": "bounds"
    },
    "header": {
      "labelFontSize": 15,
      "titleFontSize": 15
    },
    "text": {
      "fontSize": 15
    }
  }
}
